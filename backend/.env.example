# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env

# --- Which model backs the scheduling agent ---------------------------------
# ollama | gemini
#
# The evaluation harness needs hundreds of calls to say anything statistically
# meaningful, so it defaults to Ollama. Gemini's free tier has a per-day quota
# that a single evaluation sweep exhausts.
AGENT_PROVIDER=ollama

# --- Ollama -----------------------------------------------------------------
# Hosted:  https://ollama.com      (requires OLLAMA_API_KEY)
# Local:   http://localhost:11434  (leave OLLAMA_API_KEY blank)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# Hosted models carry a -cloud suffix; local ones do not.
# List what your key can reach:
#   curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/api/tags
OLLAMA_MODEL=gpt-oss:120b-cloud

# --- Gemini (optional; only read when AGENT_PROVIDER=gemini) ----------------
GEMINI_API_KEY=

# --- Simulation -------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./simulation.db
NUM_SERVERS=8
SIM_DELAY=0.5
CORS_ORIGINS=*
